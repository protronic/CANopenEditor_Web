{
  "name": "canopen-editor-web",
  "version": "1.0.0",
  "private": true,
  "description": "Angular-Webapp zum Lesen und Schreiben von CANopen-XDD-Dateien.",
  "license": "GPL-3.0-only",
  "main": "electron/main.js",
  "scripts": {
    "start": "ng serve --host 0.0.0.0 --port 4200",
    "build": "ng build",
    "build:electron": "ng build --base-href ./",
    "electron:dev": "concurrently \"npm run start\" \"wait-on http://localhost:4200 && electron .\"",
    "electron:build": "npm run build:electron",
    "electron:start": "electron .",
    "electron:package": "npm run build:electron && electron-builder build --dir",
    "electron:package:win": "npm run build:electron && electron-builder build --win --x64 --dir",
    "electron:package:linux": "npm run build:electron && electron-builder build --linux --x64 --dir",
    "electron:package:mac": "npm run build:electron && electron-builder build --mac --x64 --dir",
    "test": "vitest run"
  },
  "dependencies": {
    "@angular/common": "^19.2.14",
    "@angular/compiler": "^19.2.14",
    "@angular/core": "^19.2.14",
    "@angular/forms": "^19.2.14",
    "@angular/platform-browser": "^19.2.14",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "^19.2.15",
    "@angular/cli": "^19.2.15",
    "@angular/compiler-cli": "^19.2.14",
    "concurrently": "^10.0.7",
    "electron": "^45.3.0",
    "electron-builder": "^26.18.0",
    "jsdom": "^26.1.0",
    "typescript": "~5.7.3",
    "vitest": "^3.2.4",
    "wait-on": "^9.5.1"
  }
}
